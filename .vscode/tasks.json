{
    "version": "2.0.0",
    "presentation": {
        "reveal": "silent",
        "revealProblems": "onProblem",
        "close": true
    },
    "problemMatcher": [],
    "tasks": [
        {
            "label": "LeetCode: Fetch",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python"
            },
            "args": ["${workspaceFolder}/scripts/lc.py", "${input:lc_url}"],
            "options": {
                "env": {
                    "LEETCODE_EDITOR": "code"
                }
            }
        },
        {
            "label": "LeetCode: Load",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python"
            },
            "args": ["${workspaceFolder}/scripts/lc.py", "load", "${input:load_key}"],
            "hide": true
        },
        {
            "label": "LeetCode: Run",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python"
            },
            "args": ["${workspaceFolder}/scripts/lc.py", "run", "${file}"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "close": false,
                "clear": true
            }
        },
        {
            "label": "LeetCode: Sync",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python"
            },
            "args": ["${workspaceFolder}/scripts/lc.py", "sync"],
            "hide": true
        }
    ],
    "inputs": [
        {
            "id": "lc_url",
            "type": "promptString",
            "description": "Enter LeetCode URL / problem ID / w113 / b113:"
        },
        {
            "id": "load_key",
            "type": "promptString",
            "description": "Enter key to load (e.g. 87, w157_Q2):"
        }
    ]
}
